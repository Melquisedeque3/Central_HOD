{
  "manifest_version": 3,
  "name": "HOD Controle — Home Office Digital",
  "version": "1.0.0",
  "description": "Painel de controle de candidaturas, projetos e rotinas integrado ao Google Planilhas, Google Agenda e Assistente Gemini.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Abrir HOD Controle"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
