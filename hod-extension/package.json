{
  "name": "hod-central-home-office",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "HOD — página local para operar candidaturas, tarefas e rotina. Obsidian é a fonte de verdade, Hermes Agent é o cérebro operacional. Sem build e sem dependências.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:work-e2e": "node scripts/work-e2e.mjs",
    "test:work-restart": "node scripts/work-restart-check.mjs",
    "test:unit": "node scripts/unit-resilience.mjs",
    "test:security": "node scripts/security-integration.mjs",
    "test:performance": "node scripts/performance.mjs",
    "mcp": "node mcp/hod-mcp.mjs",
    "test:mcp": "node scripts/mcp-integration.mjs",
    "test:collectors": "python3 collectors/test_lever_collector.py",
    "test:collector-integration": "node scripts/collector-integration.mjs",
    "collect:crowdgen": "python3 collectors/lever_collector.py --site appen --source 'CrowdGen / Appen'",
    "seed": "node scripts/seed.mjs"
  },
  "keywords": [
    "obsidian",
    "hermes-agent",
    "local-first",
    "markdown",
    "job-search"
  ],
  "license": "MIT"
}
