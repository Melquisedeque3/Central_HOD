{
  "manifest_version": 3,
  "name": "HOD — Central de Carreira",
  "version": "2.0.0",
  "description": "Central pessoal de candidaturas, processos, prazos e estudos, com Obsidian como backend.",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Abrir HOD"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
